# Local development defaults. Copy to .env and replace the secret values.
DATABASE_URL=sqlite+aiosqlite:///./churn_predictions.db
MODEL_PATH=saved_models/churn_model.pkl
API_PORT=8000
RATE_LIMIT_PREDICT=60/minute

# Required by docker-compose.yml
POSTGRES_PASSWORD=replace-with-a-local-database-password
SECRET_KEY=replace-with-a-random-secret
